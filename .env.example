# OpenAI
OPENAI_API_KEY=sk-...

# Qdrant (local: http://localhost:6333)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Collection
COLLECTION_NAME=docs-index

# Optional GCP (later phases)
GCP_PROJECT_ID=
GCS_BUCKET_DOCS=
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
ENVIRONMENT=development
LOG_LEVEL=INFO

# UI-to-API base URL (used by Streamlit webui service)
DOCUMIND_API_URL=http://api:8000
